<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>PrivacyScreen</AssemblyName>
    <RootNamespace>PrivacyScreen</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.4.0</Version>
    <AssemblyVersion>1.4.0</AssemblyVersion>
    <FileVersion>1.4.0</FileVersion>
    <Authors>XcfyX</Authors>
    <Description>Privacy-friendly Windows screensaver for remote desktop workflows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\indicator-default.png" LogicalName="PrivacyScreen.Resources.indicator-default.png" />
  </ItemGroup>
</Project>
